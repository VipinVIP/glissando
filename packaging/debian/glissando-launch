#!/bin/sh
# Starts glissando; falls back to the next installed keyboard (Stevia or
# Squeekboard) after three failures within five minutes.
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/glissando"
mkdir -p "$STATE"
now=$(date +%s)
recent=0
if [ -f "$STATE/crashes" ]; then
    for t in $(cat "$STATE/crashes"); do
        [ $((now - t)) -lt 300 ] && recent=$((recent + 1))
    done
fi
if [ "$recent" -ge 3 ]; then
    echo "glissando: repeated failures, starting the fallback keyboard" >&2
    for osk in /usr/bin/phosh-osk-stevia /usr/bin/squeekboard; do
        [ -x "$osk" ] && exec "$osk" --allow-replacement
    done
fi
/usr/bin/glissando --allow-replacement
rc=$?
if [ "$rc" -ne 0 ] && [ "$rc" -ne 143 ]; then
    { [ -f "$STATE/crashes" ] && tail -n 5 "$STATE/crashes"; echo "$now"; } > "$STATE/crashes.new"
    mv "$STATE/crashes.new" "$STATE/crashes"
fi
exit "$rc"
